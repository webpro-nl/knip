{
  "name": "knip",
  "version": "6.42.1",
  "description": "Find and fix unused dependencies, exports and files in your TypeScript and JavaScript projects",
  "keywords": [
    "analysis",
    "analyze",
    "class",
    "cli",
    "dead code",
    "dependencies",
    "detect",
    "devDependencies",
    "duplicate",
    "entropy",
    "enum",
    "export",
    "files",
    "find",
    "javascript",
    "lint",
    "maintenance",
    "members",
    "missing",
    "monorepo",
    "namespace",
    "package",
    "scan",
    "types",
    "typescript",
    "unreferenced",
    "unresolved",
    "unused",
    "workspace"
  ],
  "homepage": "https://knip.dev",
  "bugs": "https://github.com/webpro-nl/knip/issues",
  "license": "ISC",
  "author": {
    "name": "Lars Kappert",
    "email": "lars@webpro.nl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webpro-nl/knip.git",
    "directory": "packages/knip"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/webpro"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/knip"
    }
  ],
  "bin": {
    "knip": "bin/knip.js",
    "knip-bun": "bin/knip-bun.js"
  },
  "files": [
    "dist",
    "native/*.cjs",
    "native/knip-native.*.node",
    "native/knip-native.*.json",
    "native/knip-native.wasm32-wasi.wasm",
    "native/wasi-worker.mjs",
    "schema.json",
    "schema-jsonc.json",
    "native/wasi-runtime.LICENSE"
  ],
  "type": "module",
  "types": "./dist/types.d.ts",
  "exports": {
    "./native": "./native/index.cjs",
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    }
  },
  "scripts": {
    "knip": "node ./src/cli.ts --directory ../..",
    "knip:production": "node ./src/cli.ts --directory ../.. --production --strict",
    "lint": "oxlint",
    "fmt": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.prettierignore",
    "test": "node scripts/run-test.js",
    "build:native": "node scripts/build-native.js",
    "build:wasi": "node scripts/build-native.js --napi --target wasm32-wasip1-threads",
    "check:native": "node scripts/check-native-artifacts.js",
    "collect:native": "node scripts/collect-native-artifacts.js",
    "test:native-tooling": "node --test scripts/native-artifacts.test.js scripts/native-loader.test.js scripts/wasi-runtime.test.js",
    "prepack": "pnpm run check:native",
    "prepublishOnly": "pnpm run check:native --publish",
    "prebuild": "pnpm run build:native && pnpm run generate-plugin-defs && node rmdir.js dist",
    "build": "tsc",
    "qa": "pnpm lint && pnpm build && pnpm knip && pnpm knip:production && pnpm test",
    "release": "KNIP_NATIVE_REVISION=${KNIP_NATIVE_REVISION:-$(git rev-parse HEAD)} NODE_OPTIONS=--no-deprecation release-it",
    "create-plugin": "node ./scripts/create-new-plugin.ts",
    "postcreate-plugin": "pnpm run build && (oxfmt schema.json schema-jsonc.json src/schema/plugins.ts || true)",
    "generate-plugin-defs": "node ./scripts/generate-plugin-defs.js && (oxfmt src/plugins/index.ts src/types/PluginNames.ts src/schema/plugins.ts || true)"
  },
  "dependencies": {
    "formatly": "^0.11.4",
    "get-tsconfig": "4.14.3",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.154.0",
    "oxc-resolver": "11.24.2",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.0",
    "strip-json-comments": "5.0.3",
    "tinyglobby": "^0.2.17",
    "unbash": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.6",
    "@emnapi/runtime": "2.0.0-alpha.6",
    "@jest/types": "^30.5.1",
    "@napi-rs/cli": "3.10.8",
    "@napi-rs/wasm-runtime": "1.2.5",
    "@types/bun": "^1.4.3",
    "@types/picomatch": "^4.0.3",
    "codeclimate-types": "^0.3.1",
    "emnapi": "2.0.0-alpha.6",
    "prettier": "^3.9.10",
    "rolldown": "1.2.14",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "webpack": "^5.111.1"
  },
  "napi": {
    "binaryName": "knip-native"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "engineStrict": true
}
