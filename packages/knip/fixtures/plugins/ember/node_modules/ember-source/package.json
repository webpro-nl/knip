{
  "name": "ember-source",
  "version": "7.4.0",
  "exports": {
    "./*": "./dist/packages/*"
  },
  "keywords": [
    "ember-addon"
  ],
  "ember-addon": {
    "version": 2,
    "renamed-modules": {
      "@ember/application/index.js": "ember-source/@ember/application/index.js",
      "@ember/routing/router.js": "ember-source/@ember/routing/router.js",
      "@ember/debug/index.js": "ember-source/@ember/debug/index.js",
      "@glimmer/tracking/index.js": "ember-source/@glimmer/tracking/index.js",
      "@glimmer/validator/index.js": "ember-source/@glimmer/validator/index.js",
      "@ember/version/index.js": "ember-source/@ember/version/index.js"
    }
  }
}
