{
  "jsPlugins": [
    "eslint-plugin-unused-imports",
    "eslint-plugin-security",
    { "name": "jsdoc-js", "specifier": "eslint-plugin-jsdoc" },
    "./local-plugin.mjs",
    "./[variant]/plugin.mjs"
  ],
  "overrides": [
    {
      "jsPlugins": ["eslint-plugin-import"]
    }
  ],
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": "tsconfig.json"
      }
    }
  }
}
