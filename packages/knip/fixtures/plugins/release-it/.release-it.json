{
  "github": {
    "release": true,
    "releaseNotes": "node ./bin/release-notes.js ${version}"
  },
  "npm": {
    "publish": true
  },
  "plugins": {
    "@release-it/bumper": {},
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": "angular"
    },
    "./scripts/release-it-plugin.js": {}
  },
  "hooks": {
    "before:init": ["npm run lint", "npm test"],
    "after:bump": "from-hook"
  }
}
