{
  "mcpServers": {
    "next-devtools": {
      "command": "bunx",
      "args": ["next-devtools-mcp@0.4.0"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./docs"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "claude": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/scripts/claude-server.ts"]
    },
    "catalog": {
      "command": "bun",
      "args": ["run", "server.ts"],
      "cwd": "tools/catalog"
    }
  }
}
