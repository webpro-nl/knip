---
import Adobe from '../assets/projects/adobe.svg';
import AGGrid from '../assets/projects/ag-grid.svg';
import AGGrid2 from '../assets/projects/ag-grid2.svg';
import Anthropic from '../assets/projects/anthropic.svg';
import ArkType from '../assets/projects/arktype.svg';
import AstroLogo from '../assets/projects/astro.svg';
import AWS from '../assets/projects/aws.svg';
import Babel from '../assets/projects/babel.svg';
import Backstage from '../assets/projects/backstage.svg';
import Cloudflare from '../assets/projects/cloudflare.svg';
import CreateTypeScriptApp from '../assets/projects/create-typescript-app.png';
import Datadog from '../assets/projects/datadog.svg';
import ESLint from '../assets/projects/eslint.svg';
import FreeCodeCamp from '../assets/projects/freecodecamp.svg';
import Ghost from '../assets/projects/ghost.svg';
import Google from '../assets/projects/google.svg';
import Grafana from '../assets/projects/grafana.svg';
import Guardian from '../assets/projects/guardian.svg';
import KhanAcademy from '../assets/projects/khan-academy.svg';
import Microsoft from '../assets/projects/microsoft.svg';
import Mocha from '../assets/projects/mocha.svg';
import N8n from '../assets/projects/n8n.svg';
import Nuxt from '../assets/projects/nuxt.svg';
import Nvidia from '../assets/projects/nvidia.svg';
import Oxc from '../assets/projects/oxc.svg';
import Prettier from '../assets/projects/prettier.svg';
import Sanity from '../assets/projects/sanity.svg';
import SAP from '../assets/projects/sap.svg';
import Sentry from '../assets/projects/sentry.svg';
import Shopify from '../assets/projects/shopify.svg';
import Signal from '../assets/projects/signal.svg';
import SourceGraph from '../assets/projects/sourcegraph.svg';
import Stately from '../assets/projects/stately.svg';
import Storybook from '../assets/projects/storybook.svg';
import Supabase from '../assets/projects/supabase.svg';
import Svelte from '../assets/projects/svelte.svg';
import TanStack from '../assets/projects/tanstack.svg';
import TypeScriptESLint from '../assets/projects/typescript-eslint.svg';
import Vercel from '../assets/projects/vercel.svg';
---

<style>
  div {
    margin-top: 4rem;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    list-style: none;
    padding: 0;
  }

  a {
    border-bottom: none !important;
    display: flex;
  }

  svg, img {
    width: auto;
    height: 32px !important;
    margin: 0 !important;
    opacity: 0.9;
    transition: all 0.3s ease;
    filter: brightness(0.6) grayscale(100%)
  }

  :global([data-theme=light]) svg {
    opacity: 0.7;
  }

  .contrast svg {
    opacity: 1;
    filter: contrast(1) grayscale(100%)
  }
  .shrink {
    margin: 0 -3%;
    svg {
      scale: 0.75;
    }
  }
  .grow svg {
    scale: 1.25;
  }
  .blowup svg {
    scale: 2.1;
  }
  .raise svg {
    translate: 0 -6px;
  }
  .sink svg {
    translate: 0 6px;
  }


  #projects a:hover,
  #projects.show-all a {
    color: #fff;
  }

  #projects a:hover svg,
  #projects a:hover img,
  #projects.show-all svg,
  #projects.show-all img {
    filter: none;
  }

  :global([data-theme=light]) #projects a:hover,
  :global([data-theme=light]) #projects.show-all a {
    color: #111;
  }

  :global([data-theme=light]) #projects a:hover svg,
  :global([data-theme=light]) #projects a:hover img,
  :global([data-theme=light]) #projects.show-all svg,
  :global([data-theme=light]) #projects.show-all img {
    opacity: 1;
    filter: none;
  }
</style>

<div id="projects">
    <a href="https://github.com/search?type=code&q=org:adobe%20knip" class="contrast grow"><Adobe /></a>
    <a href="https://github.com/search?type=code&q=org:ag-grid%20knip"><AGGrid /><AGGrid2 /></a>
    <a href="https://github.com/search?type=code&q=org:anthropics%20knip" class="shrink"><Anthropic /></a>
    <a href="https://github.com/search?type=code&q=org:arktypeio%20knip" class="grow"><ArkType /></a>
    <a href="https://github.com/search?type=code&q=org:withastro%20knip"><AstroLogo /></a>
    <a href="https://github.com/search?type=code&q=org:aws-samples%20knip" class="sink" ><AWS/></a>
    <a href="https://github.com/search?type=code&q=org:babel%20knip"><Babel /></a>
    <a href="https://github.com/search?type=code&q=org:backstage%20knip"><Backstage /></a>
    <a href="https://github.com/search?type=code&q=org:cloudflare%20knip" class="grow"><Cloudflare /></a>
    <a href="https://github.com/search?type=code&q=org:datadog%20knip"><Datadog /></a>
    <a href="https://github.com/search?type=code&q=org:eslint%20knip" class="contrast"><ESLint /></a>
    <a href="https://github.com/search?type=code&q=org:freeCodeCamp%20knip"><FreeCodeCamp /></a>
    <a href="https://github.com/search?type=code&q=org:TryGhost%20knip"><Ghost /></a>
    <a href="https://github.com/search?type=code&q=org:google-gemini%20knip"><Google /></a>
    <a href="https://github.com/search?type=code&q=org:grafana%20knip"><Grafana /></a>
    <a href="https://github.com/search?type=code&q=org:guardian%20knip"><Guardian /></a>
    <a href="https://github.com/search?type=code&q=org:Khan%20knip"><KhanAcademy /></a>
    <a href="https://github.com/search?type=code&q=org:JoshuaKGoldberg%20knip"><img src={CreateTypeScriptApp.src}/></a>
    <a href="https://github.com/search?type=code&q=org:microsoft%20knip"><Microsoft /></a>
    <a href="https://github.com/search?type=code&q=org:mochajs%20knip" class="contrast grow"><Mocha /></a>
    <a href="https://github.com/search?type=code&q=org:n8n-io%20knip" aria-label="n8n"><N8n /></a>
    <a href="https://github.com/search?type=code&q=org:nuxt%20knip"><Nuxt /></a>
    <a href="https://github.com/search?type=code&q=org:NVIDIA%20knip" class="shrink"><Nvidia /></a>
    <a href="https://github.com/search?type=code&q=org:oxc-project%20knip" class="shrink"><Oxc /></a>
    <a href="https://github.com/search?type=code&q=org:prettier%20knip" class="contrast grow"><Prettier /></a>
    <a href="https://github.com/search?type=code&q=org:sanity-io%20knip"><Sanity /></a>
    <a href="https://github.com/search?type=code&q=org:SAP%20knip" class="blowup"><SAP /></a>
    <a href="https://github.com/search?type=code&q=org:getsentry%20knip"><Sentry /></a>
    <a href="https://github.com/search?type=code&q=org:shopify%20knip"><Shopify /></a>
    <a href="https://github.com/search?type=code&q=org:signalapp%20knip" class="grow"><Signal /></a>
    <a href="https://github.com/search?type=code&q=org:sourcegraph%20knip"><SourceGraph /></a>
    <a href="https://github.com/search?type=code&q=org:statelyai%20knip"><Stately /></a>
    <a href="https://github.com/search?type=code&q=org:storybookjs%20knip"><Storybook  /></a>
    <a href="https://github.com/search?type=code&q=org:supabase%20knip"><Supabase /></a>
    <a href="https://github.com/search?type=code&q=org:sveltejs%20knip"><Svelte /></a>
    <a href="https://github.com/search?type=code&q=org:tanstack%20knip" class="shrink"><TanStack /></a>
    <a href="https://github.com/search?type=code&q=org:typescript-eslint%20knip" class="contrast grow"><TypeScriptESLint/></a>
    <a href="https://github.com/search?type=pullrequests&q=org:vercel%20knip" class="shrink"><Vercel/></a>
</div>

<script>
  const projects = document.getElementById('projects');
  const heading = projects?.closest('.projects')?.previousElementSibling;
  if (heading instanceof HTMLElement) {
    heading.style.cursor = 'pointer';
    heading.addEventListener('click', (e) => {
      e.preventDefault();
      projects?.classList.toggle('show-all');
    });
  }
</script>
